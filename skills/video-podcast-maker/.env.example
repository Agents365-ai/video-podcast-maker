# TTS Configuration (synthesis is local — edge is free, no key; azure needs a key)
TTS_BACKEND=edge          # Options: edge (default, free), azure
TTS_RATE="+5%"
# TTS_VOICE=              # Optional voice override; unset = per-backend default
# TTS_STYLE=gentle        # Azure express-as style (azure only; empty disables the wrapper)

# Azure Speech (if using the azure backend)
# AZURE_SPEECH_KEY=your-key-here
# AZURE_SPEECH_REGION=eastasia

# Optional: AI thumbnails (imagencn — any one of these)
# GEMINI_API_KEY=your-key
# DASHSCOPE_API_KEY=your-key
# ARK_API_KEY=your-key
# HUNYUAN_API_KEY=your-key
# ZHIPUAI_API_KEY=your-key
# STEP_API_KEY=your-key
